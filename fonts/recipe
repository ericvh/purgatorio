# What `cargo xtask fonts` makes in root/fonts, with fontgen
# (appl/cmd/fontgen). Inputs are relative to this directory.

# Go Regular and Go Mono at 13 and 20 pixels, 8-bit grey.
ttf go/Go-Regular.ttf 13 go/regular.13
ttf go/Go-Regular.ttf 20 go/regular.20
ttf go/Go-Mono.ttf 13 go/mono.13
ttf go/Go-Mono.ttf 20 go/mono.20

# GNU Unifont: the whole Basic Multilingual Plane, 1-bit, 16 pixels.
hex unifont/unifont-18.0.01.hex unifont/unifont-combining-18.0.01.txt unifont/unifont.16

# The fonts programs use: Go first, Unifont for the runes Go lacks.
merge sans/unicode.13 go/regular.13 unifont/unifont.16
merge sans/unicode.20 go/regular.20 unifont/unifont.16
merge mono/unicode.13 go/mono.13 unifont/unifont.16
merge mono/unicode.20 go/mono.20 unifont/unifont.16
merge default sans/unicode.13

# The licences travel with the fonts made from them.
copy go/README go/LICENSE
copy unifont/OFL-1.1.txt unifont/OFL-1.1.txt
copy unifont/COPYING unifont/COPYING
copy README.fonts README
